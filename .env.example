POSTGRES_DB=clinica_ramirez
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

API_PORT=5000
WEB_PORT=5173

JWT_SECRET=CHANGE_ME
JWT_ISSUER=clinica_ramirez
JWT_AUDIENCE=clinica_ramirez_web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Browser-restricted Google Maps key; never commit a real value.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Google Identity Services: same Web OAuth client ID on frontend and backend.
VITE_GOOGLE_CLIENT_ID=
GoogleAuth__ClientId=

# Optional cloud connection. Blank keeps local POSTGRES_* configuration.
ConnectionStrings__DefaultConnection=
VITE_API_BASE_URL=
# Production-only examples: supply actual approved origins privately.
# Cors__AllowedOrigins__0=https://<frontend-host>
# AuthCookies__CrossSite=true
# DataProtection__KeysPath=<durable-private-directory>
